{
  "$schema": "vscode://schemas/color-theme",
  "name": "Firawynix Cyan",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#080e1b", "editor.foreground": "#d5dbea",
    "editorLineNumber.foreground": "#64748f", "editorLineNumber.activeForeground": "#91ebf1",
    "editor.lineHighlightBackground": "#111c2c", "editor.lineHighlightBorder": "#111c2c",
    "editor.selectionBackground": "#11798966", "editor.inactiveSelectionBackground": "#11556455",
    "editorCursor.foreground": "#52e4ee", "editorIndentGuide.background1": "#25324a",
    "editorIndentGuide.activeBackground1": "#546381", "editorGutter.background": "#080e1b",
    "minimap.background": "#080e1b", "minimap.selectionHighlight": "#52e4ee55",
    "diffEditor.insertedTextBackground": "#3cac5b30", "diffEditor.removedTextBackground": "#cf526c33",
    "diffEditor.insertedLineBackground": "#173b244f", "diffEditor.removedLineBackground": "#521e2b55",
    "diffEditor.diagonalFill": "#1f2e44", "editorOverviewRuler.border": "#080e1b",
    "sideBar.background": "#090f1c", "sideBar.foreground": "#bdc8db", "activityBar.background": "#080e1a",
    "panel.background": "#080e1b", "panel.border": "#29344b", "panelTitle.activeBorder": "#52e4ee",
    "terminal.background": "#080e1b", "terminal.foreground": "#c4cfdf",
    "terminal.ansiGreen": "#78cd9a", "terminal.ansiBrightGreen": "#a0dfb7",
    "terminal.ansiRed": "#e18390", "terminal.ansiYellow": "#d6be87", "terminal.ansiBlue": "#81afe4",
    "terminal.ansiCyan": "#52e4ee", "terminal.ansiMagenta": "#7fd8e4",
    "statusBar.background": "#0b1220", "statusBar.foreground": "#b5c3d8",
    "statusBar.noFolderBackground": "#0b1220", "statusBar.debuggingBackground": "#17233b",
    "tab.activeBackground": "#111a2b", "tab.inactiveBackground": "#080e1b", "tab.activeBorderTop": "#52e4ee",
    "titleBar.activeBackground": "#080e19", "titleBar.activeForeground": "#d9fbff",
    "input.background": "#111b2d", "input.foreground": "#d8e1f1", "input.border": "#34425d",
    "button.background": "#127488", "button.foreground": "#e8feff", "button.hoverBackground": "#159ab0",
    "focusBorder": "#52e4ee", "list.activeSelectionBackground": "#163d4b",
    "list.inactiveSelectionBackground": "#20283b", "list.hoverBackground": "#162136",
    "dropdown.background": "#101a2b", "dropdown.border": "#34425d",
    "editorWidget.background": "#111a2b", "editorWidget.border": "#34425d",
    "notificationCenterHeader.background": "#152035", "notifications.background": "#0f192c"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#839c7c", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#70d8ec" } },
    { "scope": ["string", "string.regexp"], "settings": { "foreground": "#b8c98d" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#e2b88c" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#90c8e9" } },
    { "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"], "settings": { "foreground": "#81cbbb" } },
    { "scope": ["variable.parameter", "variable.other"], "settings": { "foreground": "#c7d8ec" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#98bde8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#88d4e4" } },
    { "scope": ["punctuation", "meta.brace", "keyword.operator"], "settings": { "foreground": "#b2bfd4" } }
  ]
}
